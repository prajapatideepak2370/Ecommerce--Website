# ============================================
# TRYVOXEL³ — Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to source control.
# ============================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (MongoDB Atlas) ---
# Provided cluster: kingprajapati2200226_db_user / bh4KquJW5CXwyPLX
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority

# --- Session / Auth ---
SECRET_KEY=<long-random-string-at-least-32-chars>

# --- CORS (comma-separated for multiple origins) ---
CORS_ORIGIN=http://localhost:5173

# --- Cloudinary ---
CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUD_API_KEY=<your-cloudinary-api-key>
CLOUD_API_SECRET=<your-cloudinary-api-secret>

# --- Checkout / Pricing Rules ---
# Percentage applied as tax (e.g. 18 = 18% GST)
TAX_PERCENT=18
# Flat shipping fee in INR
SHIPPING_FEE=99
# Free shipping when subtotal >= this amount (INR)
FREE_SHIPPING_THRESHOLD=1999

# --- Inventory ---
# Warn "Low Stock" when stock <= threshold
LOW_STOCK_THRESHOLD=5

# --- Seed (initial admin user) ---
ADMIN_NAME=TRYVOXEL Admin
ADMIN_EMAIL=admin@tryvoxel.com
ADMIN_PASSWORD=<admin-password-at-least-8-chars>
ADMIN_PHONE=+910000000000
