{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/tvx-console",
          "destination": "/admin.html"
        },
        {
          "source": "/tvx-console/:path*",
          "destination": "/admin.html"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/tvx-console",
      "destination": {
        "service": "frontend",
        "path": "/admin.html"
      }
    },
    {
      "source": "/tvx-console/:path*",
      "destination": {
        "service": "frontend",
        "path": "/admin.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
