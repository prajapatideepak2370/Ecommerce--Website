{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://trivoxel-3d.onrender.com/api/v1/:path*" },
    { "source": "/api/admin/:path*", "destination": "https://trivoxel-3d.onrender.com/api/admin/:path*" },
    { "source": "/tvx-console", "destination": "/admin.html" },
    { "source": "/tvx-console/:path*", "destination": "/admin.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/tvx-console/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/tvx-console",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
