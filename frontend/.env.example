# Frontend environment. Copy to `frontend/.env` for local development.
# On Vercel, set these in Project → Settings → Environment Variables instead.
# Vite only exposes variables prefixed with VITE_ to the browser bundle —
# never put secrets in this file.

# Local customer API. Leave unset in Vercel to use its same-origin API rewrite.
VITE_API_BASE=http://localhost:5000/api/v1

# Local admin API. Leave unset in Vercel to use its same-origin API rewrite.
VITE_ADMIN_API_BASE=http://localhost:5000/api/admin

# Public base path for the separate admin React entry. Never linked from customer UI.
VITE_ADMIN_BASE=/tvx-console
