# Frontend environment. Copy to client/.env and set the backend API origins.
# Frontend environment. Production defaults to same-origin /api paths.
# Use HTTPS API URLs only when the API is hosted on a separate origin.
VITE_API_BASE=http://localhost:5000/api/v1
VITE_ADMIN_API_BASE=http://localhost:5000/api/admin
# Public base path for the separate admin React entry. Never linked from customer UI.
VITE_ADMIN_BASE=/tvx-console
