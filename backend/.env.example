# ============================================
# TRYVOXEL³ — Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to source control.
# ============================================

# --- Server ---
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# --- Database (MongoDB Atlas) ---
# Replace the placeholders with your own MongoDB Atlas connection details.
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority

# --- Session / Auth ---
SECRET_KEY=<long-random-string-at-least-32-chars>

# --- Google OAuth2 ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Set to the public HTTPS API URL in production.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/users/auth/google/callback
# Frontend URL used for post-login redirect
FRONTEND_URL=http://localhost:5173

# --- Password reset email (SMTP) ---
# Use an app password or a transactional email provider; never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TRYVOXEL <no-reply@example.com>

# --- CORS (comma-separated for multiple origins) ---
# For a same-origin AWS deployment, set this to the frontend HTTPS origin.
CORS_ORIGIN=http://localhost:5173

# --- Cloudinary ---
CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUD_API_KEY=<your-cloudinary-api-key>
CLOUD_API_SECRET=<your-cloudinary-api-secret>

# --- Razorpay Payments ---
# Get these from https://dashboard.razorpay.com → Settings → API Keys
# Use test keys in development, live keys in production.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# --- Checkout / Pricing Rules ---
# No tax, shipping, or other checkout charges are added to product prices.
TAX_PERCENT=0
SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=0

# --- Inventory ---
# Warn "Low Stock" when stock <= threshold
LOW_STOCK_THRESHOLD=5

# --- Seed (initial admin user) ---
# Set these to private values before running the admin seed/setup script.
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<set-a-unique-strong-password>
ADMIN_PHONE=<your-phone-number>

# --- Admin Portal (separate session + origins) ---
# Session secret for the admin-only cookie (tryvoxel.admin.sid). Use a separate value from SECRET_KEY.
ADMIN_SESSION_SECRET=<different-long-random-string-at-least-32-chars>
# Seconds of idle admin-session lifetime (default 7200 = 2 hours).
ADMIN_SESSION_MAX_AGE=7200
# Admin UI origin (CORS). Set to the frontend origin in production.
ADMIN_ORIGIN=http://localhost:5173
# Failed admin-login attempts before 15-minute lockout per (ip, loginId)
ADMIN_LOGIN_MAX_ATTEMPTS=5
