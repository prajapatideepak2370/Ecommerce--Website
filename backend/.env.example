# ============================================
# TRYVOXEL³ — Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to source control.
# ============================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (MongoDB Atlas) ---
# Replace the placeholders with your own MongoDB Atlas connection details.
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority

# --- Session / Auth ---
SECRET_KEY=<long-random-string-at-least-32-chars>

# --- Google OAuth2 ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
# Production callback: https://trivoxel3d-mu.vercel.app/api/v1/users/auth/google/callback
# Register that exact URI in the Google OAuth client.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Production defaults to the Vercel same-origin API rewrite.
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/users/auth/google/callback
# The backend uses the deployed Vercel URL when this is unset or points to localhost.
FRONTEND_URL=http://localhost:5173

# --- Password reset email (SMTP) ---
# Use an app password or a transactional email provider; never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TRYVOXEL <no-reply@example.com>

# --- CORS (comma-separated for multiple origins) ---
# Every browser origin allowed to call this API. Entries are exact origins
# (scheme + host, no trailing slash). A `*` in an entry is a glob, which is
# handy for Vercel preview deployments.
#
# Development:
CORS_ORIGIN=http://localhost:5173
# Production example (replace with your real Vercel domain):
# CORS_ORIGIN=https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
# Allow every Vercel preview instead of listing them (trusts any *.vercel.app
# site with credentials — only use this if you accept that trade-off):
# CORS_ORIGIN=https://*.vercel.app

# --- Cloudinary ---
CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUD_API_KEY=<your-cloudinary-api-key>
CLOUD_API_SECRET=<your-cloudinary-api-secret>

# --- Razorpay Payments ---
# Get these from https://dashboard.razorpay.com → Settings → API Keys
# Use test keys in development, live keys in production.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# --- Checkout / Pricing Rules ---
# No tax, shipping, or other checkout charges are added to product prices.
TAX_PERCENT=0
SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=0

# --- Inventory ---
# Warn "Low Stock" when stock <= threshold
LOW_STOCK_THRESHOLD=5

# --- Seed (initial admin user) ---
# Set these to private values before running the admin seed/setup script.
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<set-a-unique-strong-password>
ADMIN_PHONE=<your-phone-number>

# --- Admin Portal (separate session + origins) ---
# Session secret for the admin-only cookie (tryvoxel.admin.sid). Use a separate value from SECRET_KEY.
ADMIN_SESSION_SECRET=<different-long-random-string-at-least-32-chars>
# Seconds of idle admin-session lifetime (default 7200 = 2 hours).
ADMIN_SESSION_MAX_AGE=7200
# Admin UI origin (CORS). Set to the frontend origin in production.
ADMIN_ORIGIN=http://localhost:5173
# SameSite for the admin cookie (tryvoxel.admin.sid): strict | lax | none.
# Leave as "strict" when the console is served from this API's own site.
# Set to "none" when the console is hosted on a different origin (e.g. Vercel);
# "none" forces Secure, so it requires HTTPS. CSRF is still enforced by the
# origin allowlist above plus the X-Requested-With header check.
ADMIN_COOKIE_SAMESITE=strict
# Failed admin-login attempts before 15-minute lockout per (ip, loginId)
ADMIN_LOGIN_MAX_ATTEMPTS=5
