{
  "engines": {
    "node": ">=20.0.0"
  },
  "name": "tryvoxel",
  "version": "1.0.0",
  "description": "TRYVOXEL³ — Experiment. Create. Experience. Premium 3D e-commerce platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeders/seed.js",
    "seed-admin": "node scripts/seedAdmin.js",
    "create-admin": "node scripts/createAdmin.js",
    "test": "jest --watchAll=false --forceExit",
    "test:watch": "jest --watch",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client"
  },
  "keywords": [
    "ecommerce",
    "3d",
    "threejs",
    "mern",
    "tryvoxel"
  ],
  "author": "Jasvinder × Shruti × Vishal",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "joi": "^18.1.2",
    "lodash": "^4.17.21",
    "mongoose": "^9.3.3",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.0.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.0"
  }
}
